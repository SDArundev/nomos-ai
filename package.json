{
	"name": "nomos-ai",
	"private": true,
	"type": "module",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.2",
			"zod": "^4.1.13",
			"typescript": "^5",
			"@types/bun": "^1.3.4",
			"hono": "^4.8.2",
			"@orpc/server": "^1.12.2",
			"@orpc/openapi": "^1.12.2",
			"@orpc/zod": "^1.12.2",
			"better-auth": "^1.4.9",
			"@orpc/client": "^1.12.2"
		}
	},
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"dev:native": "turbo -F native dev",
		"dev:web": "turbo -F web dev",
		"dev:server": "turbo -F server dev",
		"db:push": "turbo -F @nomos-ai/db db:push",
		"db:studio": "turbo -F @nomos-ai/db db:studio",
		"db:generate": "turbo -F @nomos-ai/db db:generate",
		"db:migrate": "turbo -F @nomos-ai/db db:migrate",
		"check": "turbo lint",
		"test": "bun test",
		"test:ci": "bun test",
		"test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage",
		"start": "NODE_ENV=production bun run apps/server/src/index.ts"
	},
	"packageManager": "bun@1.3.0",
	"dependencies": {
		"@nomos-ai/env": "workspace:*",
		"@nomos-ai/types": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@nomos-ai/config": "workspace:*",
		"@types/bun": "^1.3.8",
		"turbo": "^2.8.3",
		"typescript": "catalog:"
	}
}
