# =============================================================================
# Git Attributes
# Based on: git-github-expert best practices
# =============================================================================

# Auto detect text files and perform LF normalization
* text=auto eol=lf

# =============================================================================
# Source Code
# =============================================================================
*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.jsx      text eol=lf
*.mjs      text eol=lf
*.cjs      text eol=lf
*.json     text eol=lf
*.css      text eol=lf
*.scss     text eol=lf
*.html     text eol=lf
*.xml      text eol=lf
*.svg      text eol=lf

# =============================================================================
# Configuration
# =============================================================================
*.yml      text eol=lf
*.yaml     text eol=lf
*.toml     text eol=lf
*.ini      text eol=lf
*.env*     text eol=lf
.env*      text eol=lf

# =============================================================================
# Documentation
# =============================================================================
*.md       text eol=lf diff=markdown
*.txt      text eol=lf
LICENSE    text eol=lf
CHANGELOG  text eol=lf

# =============================================================================
# Shell Scripts
# =============================================================================
*.sh       text eol=lf
*.bash     text eol=lf
*.zsh      text eol=lf

# =============================================================================
# Docker
# =============================================================================
Dockerfile     text eol=lf
Dockerfile*    text eol=lf
.dockerignore  text eol=lf

# =============================================================================
# Git
# =============================================================================
.gitignore     text eol=lf
.gitattributes text eol=lf

# =============================================================================
# Lockfiles (generated, exact)
# =============================================================================
bun.lockb      binary
package-lock.json text eol=lf -diff
yarn.lock      text eol=lf -diff
pnpm-lock.yaml text eol=lf -diff

# =============================================================================
# Binary files
# =============================================================================
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.webp     binary
*.avif     binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.otf      binary
*.eot      binary
*.pdf      binary
*.zip      binary
*.tar.gz   binary
*.tgz      binary
*.mp3      binary
*.mp4      binary
*.webm     binary
*.ogg      binary
*.wav      binary

# =============================================================================
# Linguist overrides (for GitHub language stats)
# =============================================================================
# Exclude vendored/generated files from stats
apps/web/src/components/ui/** linguist-vendored
*.min.js   linguist-vendored
*.min.css  linguist-vendored

# Mark specific files as documentation
*.md       linguist-documentation
