# =============================================================================
# Server Environment Variables
# =============================================================================
# Copy to .env: cp .env.example .env

# Database (SQLite via Drizzle) — path relative to monorepo root
DATABASE_URL=file:./apps/server/data/nomos.db

# Auth (better-auth) - Generate secret: openssl rand -hex 32
BETTER_AUTH_SECRET=development-secret-min-32-characters-here
BETTER_AUTH_URL=http://localhost:3008

# CORS - Frontend URL (Vite dev server)
CORS_ORIGIN=http://localhost:3001

# Node environment
NODE_ENV=development

# Claude Agent SDK (OAuth via `claude login` — no API key needed)
CLAUDE_MODEL=claude-sonnet-4-5-20250929
