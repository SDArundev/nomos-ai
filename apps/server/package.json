{
	"name": "server",
	"main": "src/index.ts",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.js"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.2.34",
		"@nomos-ai/api": "workspace:*",
		"@nomos-ai/auth": "workspace:*",
		"@nomos-ai/db": "workspace:*",
		"@nomos-ai/env": "workspace:*",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"better-auth": "catalog:",
		"dotenv": "catalog:",
		"hono": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"typescript": "catalog:",
		"tsdown": "^0.16.5",
		"@nomos-ai/config": "workspace:*",
		"@types/bun": "catalog:"
	}
}
