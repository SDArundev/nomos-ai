# =============================================================================
# NOMOS AI - Environment Variables Template
# =============================================================================
#
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values
# 3. NEVER commit .env files with real values
#
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Environment: development | staging | production
NODE_ENV=development

# Server port (default: 3008)
PORT=3008

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# Log format: pretty | json (use json in production)
LOG_FORMAT=pretty

# -----------------------------------------------------------------------------
# Database (SQLite via Drizzle)
# -----------------------------------------------------------------------------

# Database file location
DATABASE_URL=file:./data/nomos.db

# -----------------------------------------------------------------------------
# AI Provider Configuration (Required)
# -----------------------------------------------------------------------------

# Anthropic API Key - Get yours at: https://console.anthropic.com/
# Format: sk-ant-api03-xxxx...
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# Optional: Custom base URL (for proxies or enterprise deployments)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Default model for agent operations
DEFAULT_MODEL=claude-sonnet-4-20250514

# Agent execution limits
MAX_AGENT_TURNS=100
AGENT_TIMEOUT_MS=600000

# Maximum concurrent agent executions
MAX_CONCURRENCY=3

# -----------------------------------------------------------------------------
# Authentication (better-auth)
# -----------------------------------------------------------------------------

# Auth secret - Generate with: openssl rand -hex 32
# CRITICAL: Must be at least 32 characters
BETTER_AUTH_SECRET=generate-a-256-bit-secret-here-with-openssl

# Session expiration in days
SESSION_EXPIRATION_DAYS=30

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------

# Allowed directories for agent file operations
# Comma-separated list of absolute paths
# In production, restrict to specific project directories
# Example: /Users/you/projects,/home/you/work
ALLOWED_ROOT_DIRECTORIES=/Users/you/projects

# CORS allowed origins
# In development: * (allow all)
# In production: specific origins only
CORS_ORIGIN=http://localhost:3001,http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------------------------------------------------------
# WebSocket Configuration
# -----------------------------------------------------------------------------

# WebSocket server port (usually same as HTTP port)
WS_PORT=3008

# WebSocket heartbeat interval in ms
WS_HEARTBEAT_INTERVAL=30000

# -----------------------------------------------------------------------------
# Feature Flags (Development Only)
# -----------------------------------------------------------------------------

# Enable debug logging for agent streams
# DEBUG_AGENT_STREAMS=true

# Enable debug logging for tool calls
# DEBUG_TOOL_CALLS=true

# Skip authentication in development
# SKIP_AUTH=true

# -----------------------------------------------------------------------------
# Tauri Desktop Application (Optional)
# -----------------------------------------------------------------------------

# Tauri update private key (for auto-updates)
# Generate with: tauri signer generate -w ~/.tauri/nomos.key
# TAURI_PRIVATE_KEY=

# Tauri key password
# TAURI_KEY_PASSWORD=

# -----------------------------------------------------------------------------
# External Services (Optional)
# -----------------------------------------------------------------------------

# GitHub integration for PR creation
# GITHUB_TOKEN=ghp_xxxx

# Sentry error tracking
# SENTRY_DSN=https://xxx@sentry.io/xxx

# PostHog analytics
# POSTHOG_API_KEY=phc_xxxx
# POSTHOG_HOST=https://app.posthog.com
