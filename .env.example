# =============================================================================
# NOMOS AI - Environment Variables
# =============================================================================
#
# SETUP: cp .env.example .env && fill in values
# NEVER commit .env files with real secrets
#
# =============================================================================

# === Required ===
DATABASE_URL=file:./apps/server/data/nomos.db
BETTER_AUTH_SECRET=<generate-with-openssl-rand-hex-32>
BETTER_AUTH_URL=http://localhost:3008

# === Claude Auth (pick one) ===
# Option 1: API Key
# ANTHROPIC_API_KEY=sk-ant-...
#
# Option 2: OAuth credentials (paste content of ~/.claude/.credentials.json)
# CLAUDE_OAUTH_CREDENTIALS={"token":"..."}

# === Server (Hono API on port 3008) ===
PORT=3008
CORS_ORIGIN=http://localhost:3001
NODE_ENV=development
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# === Mock Mode (no API key needed) ===
# NOMOS_MOCK_AGENT=true

# === Docker-only (set automatically in docker-compose.dev.yml) ===
# ALLOWED_ROOT_DIRECTORY=/projects
# DATA_DIR=./apps/server/data
# IS_CONTAINERIZED=false

# === Web (Vite dev server on port 3001) ===
VITE_SERVER_URL=http://localhost:3008
